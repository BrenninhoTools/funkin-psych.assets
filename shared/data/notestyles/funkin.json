{
	"version": "1.0.0",
	"name": "Funkin'",
	"pixel": false,
	"splash": "noteSplashes/noteSplashes",
	"note": {
		"render": {
			"type": "sparrow",
			"image": "noteSkins/NOTE_assets"
		},
		"scale": 0.7,
		"antialiasing": true,
		"animations": {
			"left": {"prefix": "purple0", "fps": 24, "loop": true},
			"down": {"prefix": "blue0", "fps": 24, "loop": true},
			"up": {"prefix": "green0", "fps": 24, "loop": true},
			"right": {"prefix": "red0", "fps": 24, "loop": true}
		}
	},
	"hold": {
		"render": {
			"type": "sparrow",
			"image": "noteSkins/NOTE_assets"
		},
		"scale": 0.7,
		"antialiasing": true,
		"animations": {
			"left": {"prefix": "purple hold piece", "fps": 24, "loop": true},
			"leftEnd": {"prefix": "purple hold end", "fps": 24, "loop": true},
			"down": {"prefix": "blue hold piece", "fps": 24, "loop": true},
			"downEnd": {"prefix": "blue hold end", "fps": 24, "loop": true},
			"up": {"prefix": "green hold piece", "fps": 24, "loop": true},
			"upEnd": {"prefix": "green hold end", "fps": 24, "loop": true},
			"right": {"prefix": "red hold piece", "fps": 24, "loop": true},
			"rightEnd": {"prefix": "red hold end", "fps": 24, "loop": true}
		}
	},
	"strum": {
		"render": {
			"type": "sparrow",
			"image": "noteSkins/NOTE_assets"
		},
		"scale": 0.7,
		"antialiasing": true,
		"animations": {
			"left": {"prefix": "arrowLEFT", "fps": 24, "loop": true},
			"leftPress": {"prefix": "left press", "fps": 24, "loop": false},
			"leftConfirm": {"prefix": "left confirm", "fps": 24, "loop": false},
			"down": {"prefix": "arrowDOWN", "fps": 24, "loop": true},
			"downPress": {"prefix": "down press", "fps": 24, "loop": false},
			"downConfirm": {"prefix": "down confirm", "fps": 24, "loop": false},
			"up": {"prefix": "arrowUP", "fps": 24, "loop": true},
			"upPress": {"prefix": "up press", "fps": 24, "loop": false},
			"upConfirm": {"prefix": "up confirm", "fps": 24, "loop": false},
			"right": {"prefix": "arrowRIGHT", "fps": 24, "loop": true},
			"rightPress": {"prefix": "right press", "fps": 24, "loop": false},
			"rightConfirm": {"prefix": "right confirm", "fps": 24, "loop": false}
		}
